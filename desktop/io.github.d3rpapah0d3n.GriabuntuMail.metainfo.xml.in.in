<?xml version="1.0" encoding="UTF-8"?>
<!-- Downstream modification: 2026-10-27 — independent Griaß di Mail identity. -->
<!-- Copyright 2016 Software Freedom Conservancy Inc. -->
<!-- Copyright 2016, 2019 Michael Gratton <mike@vee.net> -->
<component type="desktop-application">
  <id>@appid@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <name>Griaß di Mail</name>
  <developer id="io.github.d3rpapah0d3n">
    <name>Markus Kainer (D3rPaPaH0d3n)</name>
  </developer>
  <summary>Send and receive email</summary>
  <description>
    <p>Griaß di Mail is an independent email application for the GNOME desktop,
    derived from Convey and Geary. Read, find and write email in conversations.</p>
    <p>Recipient aliases, local desktop contact photos, precise received times
    and a native session-new mail tray make incoming messages easier to follow.</p>
    <ul>
      <li>IMAP and Microsoft Graph accounts</li>
      <li>HTML and plain text message composition</li>
      <li>Desktop notifications and individual reply, archive and trash actions</li>
      <li>TNEF/winmail.dat attachment support</li>
    </ul>
    <p>This is a private development preview, independent of the original
    Convey and Geary maintainers, the GNOME Foundation and Canonical.</p>
  </description>
  <url type="homepage">https://github.com/D3rPaPaH0d3n/griass-di-mail</url>
  <url type="bugtracker">https://github.com/D3rPaPaH0d3n/griass-di-mail/issues</url>
  <url type="vcs-browser">https://github.com/D3rPaPaH0d3n/griass-di-mail</url>
  <provides><binary>griabuntu-mail</binary></provides>
  <launchable type="desktop-id">@appid@.desktop</launchable>
  <translation type="gettext">griabuntu-mail</translation>
  <releases>
    <release version="51.0+griassdi20261028.8" date="2026-10-28" type="development">
      <description><p>Public development preview with preserved fork credits,
      complete installed-artwork mapping, original licence notices, and exact
      native dependency source locations alongside the application source.</p></description>
    </release>
    <release version="51.0+griassdi20261028.7" date="2026-10-28" type="development">
      <description><p>Rename the visible application to Griaß di Mail, preserve
      the selected envelope icon, update the banner, and retain existing native
      profiles and package identity for upgrades.</p></description>
    </release>
    <release version="51.0+griabuntu20261027.2" date="2026-10-27" type="development">
      <description><p>Independent Griabuntu Mail application identity and native
      Debian packaging, retaining the verified session-new flag correction.</p></description>
    </release>
  </releases>
  <content_rating type="oars-1.1"><content_attribute id="social-contacts">intense</content_attribute></content_rating>
  <recommends><control>keyboard</control><control>pointing</control><control>touch</control></recommends>
  <requires><display_length compare="ge">360</display_length></requires>
</component>
