<component type="desktop-application">
  <id>@appid@</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <!-- Translators: The application name -->
  <name>Convey</name>
  <developer id="net.donnybeelo">
    <!-- Translators: The developer's name -->
    <name>Daniel Elia</name>
  </developer>
  <!-- Translators: The application's summary / tagline -->
  <summary>Send and receive email</summary>
  <description>
    <p>
      Convey is an email application built around conversations, for
      the GNOME desktop. It allows you to read, find and send email
      with a straightforward, modern interface.
    </p>
    <p>
      Conversations allow you to read a complete discussion without
      having to find and click from message to message.
    </p>
    <p>
      Convey is a fork of Geary, originally developed by the Geary
      Development Team and the Software Freedom Conservancy.
    </p>
    <p>Convey’s features include:</p>
    <ul>
      <li>Quick email account setup</li>
      <li>Shows related messages together in conversations</li>
      <li>Fast, full text and keyword search</li>
      <li>Full-featured HTML and plain text message composer</li>
      <li>Desktop notification of new mail</li>
      <li>Compatible with GMail, Yahoo! Mail, Outlook.com and other IMAP servers</li>
    </ul>
  </description>

  <url type="homepage">https://gitlab.gnome.org/donnybeelo/convey</url>
  <url type="bugtracker">https://gitlab.gnome.org/donnybeelo/convey/-/work_items</url>
  <url type="vcs-browser">https://gitlab.gnome.org/donnybeelo/convey</url>
  <url type="contact">https://gitlab.gnome.org/donnybeelo</url>

  <!-- Screenshots are pinned to the release tag so store listings stay
       stable. Bump these alongside each new release. -->
  <screenshots>
    <screenshot type="default">
      <caption>Convey showing an inbox of conversations</caption>
      <image>https://gitlab.gnome.org/donnybeelo/convey/-/raw/51.0/desktop/screenshots/main-window.png</image>
    </screenshot>
    <screenshot>
      <caption>Convey displaying a conversation</caption>
      <image>https://gitlab.gnome.org/donnybeelo/convey/-/raw/51.0/desktop/screenshots/conversation.png</image>
    </screenshot>
    <screenshot>
      <caption>Convey showing the rich text composer</caption>
      <image>https://gitlab.gnome.org/donnybeelo/convey/-/raw/51.0/desktop/screenshots/composer.png</image>
    </screenshot>
  </screenshots>

  <branding>
    <color type="primary" scheme_preference="light">#ffd53d</color>
    <color type="primary" scheme_preference="dark">#804400</color>
  </branding>

  <provides>
    <id>@appid@.desktop</id>
  </provides>

  <launchable type="desktop-id">@appid@.desktop</launchable>

  <translation type="gettext">convey</translation>

  <releases>
    <release version="51.0" date="2026-10-22">
      <description>
        <p>Features:</p>
        <ul>
          <li>A new look, combining the conversation list with the message viewer</li>
          <li>PGP encryption and decryption with Autocrypt support</li>
          <li>A signature for each sender address</li>
          <li>Formatting and images in signatures</li>
          <li>Show the conversation subject above the conversation viewer</li>
          <li>Configurable line order in the conversation list</li>
          <li>Add an unread filter to the search bar</li>
          <li>Add a button to unsubscribe from mailing lists</li>
          <li>Add Reply to List button for mailing lists</li>
          <li>Add proper spell-check support</li>
          <li>Manual proxy configuration</li>
        </ul>
        <p>Bug fixes:</p>
        <ul>
          <li>Search all accounts at once from All Inboxes</li>
          <li>Discard untouched replies instead of saving empty drafts</li>
          <li>Mark emails read when scrolling a conversation thread</li>
          <li>Email colours now follow GNOME's light and dark switch when HTML override is enabled</li>
          <li>Stop spam in Outlook accounts from sending notifications</li>
          <li>Fix unread counts not resetting after deleting email</li>
          <li>Handle long messages instead of failing to render</li>
          <li>Fix duplicate emails opening from notifications</li>
          <li>Fix mailto: links being ignored when Convey isn't already running</li>
          <li>Fix "View Source" not working for Flatpak builds</li>
          <li>Point the bug report and website links to Convey instead of Geary</li>
          <li>Fix clicking a folder's arrow not expanding or collapsing it</li>
          <li>"Automatically select next message" honoured after deleting</li>
          <li>Fix special folders not being found in some cases</li>
          <li>Force Ctrl+Z to only act within the textbox when a textbox is focused</li>
          <li>Fix the email font not following the system's document font</li>
          <li>Fix saved drafts gaining extra line breaks in Microsoft accounts</li>
          <li>Make "Delete" the default in permanent delete dialogs</li>
        </ul>
      </description>
    </release>
    <release version="50.2-1" date="2026-09-20">
      <description>
        <ul>
          <li>Show nested folders on Microsoft accounts</li>
          <li>Create subfolders from the folder list context menu within the app</li>
          <li>Open GNOME Online Accounts directly when adding an account</li>
        </ul>
      </description>
    </release>
  	<release version="50.2" date="2026-09-16">
      <description>
        <ul>
          <li>Refreshed application icons, screenshots and branding colours</li>
          <li>Add a combined "All Inboxes" view spanning every account</li>
          <li>Reopen the inbox last viewed at launch, or a fixed one of your choosing</li>
          <li>Remember which parts of the folder list were left collapsed</li>
          <li>Add a Starred folder for Microsoft accounts, showing its total count</li>
          <li>Page through large folders on Graph accounts</li>
        </ul>
      </description>
    </release>
    <release version="50.1" date="2026-09-11">
      <description>
        <ul>
          <li>Persist folders from Graph accounts so they load offline</li>
          <li>Fix unpredictable folder keyboard navigation</li>
          <li>Deselect conversations on Escape, disable autoselect in Trash and Junk</li>
          <li>Fix dark mode rendering in certain emails</li>
          <li>Fix context menu positioning in the message body</li>
          <li>Replace libcanberra and gsound with GStreamer for notification sounds</li>
          <li>Drop the unused libspelling dependency</li>
          <li>Numerous user interface and styling fixes</li>
        </ul>
      </description>
    </release>
    <release version="50.0" date="2026-08-26">
      <description>
        <p>The first Convey release, forked from Geary 46.0.</p>
        <p>Enhancements included in this release:</p>
        <ul>
          <li>Ported the interface to GTK4 and libadwaita</li>
          <li>Added a Microsoft Graph backend for Outlook and Microsoft 365 accounts</li>
          <li>Rebranded as Convey, with new application icons</li>
          <li>Create, rename and delete folders from the sidebar</li>
          <li>Reworked conversation list with keyboard navigation between panes</li>
          <li>Message colours now follow the system light and dark preference immediately</li>
          <li>Redrawn notification avatars, rendered at the display's pixel density</li>
          <li>Reworked address completion as a navigable dropdown</li>
          <li>Ported plugins to libpeas-2 and migrated to gcr-4 and gck-2</li>
          <li>Numerous bug fixes and user interface improvements</li>
        </ul>
      </description>
    </release>
  </releases>

  <content_rating type="oars-1.1">
    <content_attribute id="social-contacts">intense</content_attribute>
  </content_rating>

  <recommends>
    <control>touch</control>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

</component>
