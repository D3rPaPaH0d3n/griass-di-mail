<?xml version="1.0" encoding="UTF-8"?>
<!-- Downstream modification: 2026-10-27 — compact card layout and a full-width received-time line. -->
<!-- Downstream modification: 2026-10-26 — recipient badges and expanded sender details. -->
<interface>
  <template class="ConversationListRow" parent="GtkListBoxRow">
    <style>
      <class name="conversation-list"/>
    </style>
    <child>
      <object class="GtkBox" id="container">
        <property name="has-tooltip">True</property>
        <child>
          <object class="GtkRevealer" id="selected_revealer">
            <property name="transition-type">slide-right</property>
            <property name="transition-duration">150</property>
            <child>
              <object class="GtkCheckButton" id="selected_button">
                <property name="receives-default">True</property>
                <property name="valign">start</property>
                <property name="can-focus">False</property>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="date">
                <property name="xalign">0</property>
                <style>
                  <class name="date"/>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="AdwAvatar" id="sender_avatar">
            <property name="visible">False</property>
            <property name="can-focus">False</property>
            <property name="show-initials">True</property>
            <property name="size">40</property>
            <property name="valign">start</property>
            <property name="margin-start">12</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="details">
            <property name="hexpand">True</property>
            <property name="orientation">vertical</property>
            <property name="baseline-position">top</property>
            <style>
              <class name="details"/>
            </style>
            <child>
              <object class="GtkBox" id="participants_line">
                <property name="spacing">8</property>
                <style>
                  <class name="participants-line"/>
                </style>
                <child>
                  <object class="GtkBox" id="recipient_aliases">
                    <property name="visible">False</property>
                    <property name="spacing">4</property>
                    <property name="halign">start</property>
                    <property name="valign">center</property>
                    <style>
                      <class name="recipient-aliases"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="participants">
                    <property name="use-markup">True</property>
                    <property name="ellipsize">middle</property>
                    <property name="single-line-mode">True</property>
                    <property name="width-chars">4</property>
                    <property name="hexpand">True</property>
                    <property name="valign">center</property>
                    <property name="xalign">0</property>
                    <style>
                      <class name="participants"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="subject">
                <property name="halign">start</property>
                <property name="hexpand">True</property>
                <property name="ellipsize">end</property>
                <property name="single-line-mode">True</property>
                <property name="xalign">0</property>
                <style>
                  <class name="subject"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkBox" id="preview_box">
                <child>
                  <object class="GtkImage" id="encrypted_icon">
                    <property name="visible">False</property>
                    <property name="icon-name">channel-secure-symbolic</property>
                    <style>
                      <class name="preview-icon"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="preview">
                    <property name="halign">start</property>
                    <property name="hexpand">True</property>
                    <property name="single-line-mode">True</property>
                    <property name="wrap">False</property>
                    <property name="ellipsize">end</property>
                    <property name="xalign">0</property>
                    <style>
                      <class name="preview"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="indicators">
            <property name="vexpand">True</property>
            <property name="orientation">vertical</property>
            <child>
              <object class="GtkBox">
                <property name="halign">end</property>
                <property name="spacing">5</property>
                <child>
                  <object class="GtkImage" id="flagged_icon">
                    <property name="icon-name">starred-symbolic</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="count_badge">
                    <style>
                      <class name="count-badge"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
