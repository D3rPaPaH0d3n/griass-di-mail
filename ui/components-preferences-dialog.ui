<?xml version="1.0" encoding="UTF-8"?>
<!-- Downstream modification: 2026-10-26 — downstream preference rows. -->
<interface>
  <template class="ComponentsPreferencesDialog" parent="AdwPreferencesDialog">
    <property name="content-height">700</property>
    <child>
      <object class="AdwPreferencesPage">
        <!-- Translators: Preferences page title -->
        <property name="title" translatable="yes">Preferences</property>
        <property name="icon-name">preferences-other-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwSwitchRow" id="remember_last_inbox_row">
                <property name="title" translatable="yes">_Reopen last inbox</property>
                <property name="subtitle" translatable="yes">Open whichever inbox was viewed last</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="startup_inbox_row">
                <property name="title" translatable="yes">Inbox at _startup</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="startup_notifications_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">_Watch for new mail when closed</property>
                <property name="tooltip-text" translatable="yes">Griaß di Mail will keep running after all windows are closed</property>
                <property name="use-underline">True</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwSwitchRow" id="local_starred_folder_row">
                <property name="title" translatable="yes">_Always show Starred folder</property>
                <property name="subtitle" translatable="yes">Show a local Starred folder for accounts whose server does not provide one</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="AdwActionRow">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">_Conversation list order</property>
                <property name="subtitle" translatable="yes">Choose which lines each conversation shows, and in what order</property>
                <property name="use-underline">True</property>
                <property name="activatable">True</property>
                <signal name="activated" handler="on_conversation_list_activated"/>
                <child type="suffix">
                  <object class="GtkImage">
                    <property name="icon-name">go-next-symbolic</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="autoselect_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">_Automatically select next message</property>
                <property name="use-underline">True</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwSwitchRow" id="trust_images_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">_Load images from verified senders</property>
                <property name="subtitle" translatable="yes">Showing remote images allows the sender to track you</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="unverified_images_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">Also load images from _unverified senders</property>
                <property name="subtitle" translatable="yes">Messages that can't be verified are often spam or phishing</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="unset_html_colors_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">_Override the original colors in HTML emails</property>
                <property name="subtitle" translatable="yes">Overrides the original colors in HTML messages to integrate better with the app theme.</property>
                <property name="use-underline">True</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwSwitchRow" id="single_key_shortcuts_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">Use _single key email shortcuts</property>
                <property name="tooltip-text" translatable="yes">Enable keyboard shortcuts for email actions that do not require pressing &lt;Ctrl&gt;</property>
                <property name="use-underline">True</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <property name="title" translatable="yes">Contact pictures and privacy</property>
            <property name="description" translatable="yes">Local contact photos take priority. External lookups are optional and do not change images inside emails. Pictures do not verify a sender's identity.</property>
            <child>
              <object class="AdwSwitchRow" id="remote_contact_pictures_row">
                <property name="title" translatable="yes">Allow Gravatar contact pictures</property>
                <property name="subtitle" translatable="yes">Send a SHA-256 hash of displayed email addresses to Gravatar. The service also receives your IP address. Off by default; turning off cancels lookups and clears the memory cache.</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="company_pictures_row">
                <property name="title" translatable="yes">Allow company and website icons</property>
                <property name="subtitle" translatable="yes">If no contact picture is found, send the email domain to DuckDuckGo's icon service. It also receives your IP address. These icons may be missing or inaccurate.</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwSwitchRow" id="custom_proxy_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">Use _custom proxy</property>
                <property name="subtitle" translatable="yes">Set a proxy for Griaß di Mail to use for all network requests</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="proxy_uri_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">Proxy Address (e.g. socks5://127.0.0.1:9050)</property>
                <property name="show-apply-button">True</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesPage">
        <!-- Translators: Preferences page title -->
        <property name="title" translatable="yes">Plugins</property>
        <property name="icon-name">application-x-addon-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup" id="plugins_group">
          </object>
        </child>
      </object>
    </child>
  </template>
  <object class="AdwNavigationPage" id="conversation_list_subpage">
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">
            <child>
              <object class="AdwPreferencesGroup" id="conversation_list_group">
                <property name="header-suffix">
                  <object class="GtkButton" id="conversation_list_reset_button">
                    <!-- Translators: Button that restores the default conversation list line order -->
                    <property name="label" translatable="yes">_Reset</property>
                    <property name="use-underline">True</property>
                    <property name="valign">end</property>
                    <signal name="clicked" handler="on_conversation_list_reset"/>
                  </object>
                </property>
                <!-- Translators: Preferences page title -->
                <property name="title" translatable="yes">Conversation list order</property>
                <property name="description" translatable="yes">Choose which lines each conversation shows, and in what order</property>
                <child>
                  <object class="AdwSwitchRow" id="display_participants_row">
                    <!-- Translators: Preferences label -->
                    <property name="title" translatable="yes">_Participants</property>
                    <property name="use-underline">True</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSwitchRow" id="display_subject_row">
                    <!-- Translators: Preferences label -->
                    <property name="title" translatable="yes">S_ubject</property>
                    <property name="use-underline">True</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSwitchRow" id="display_preview_row">
                    <!-- Translators: Preferences label -->
                    <property name="title" translatable="yes">Pr_eview</property>
                    <property name="use-underline">True</property>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="AdwPreferencesGroup">
                <child>
                  <object class="AdwSwitchRow" id="display_recipient_aliases_row">
                    <property name="title" translatable="yes">Show recipient _aliases</property>
                    <property name="subtitle" translatable="yes">Show configured account addresses found in To/Cc of loaded messages</property>
                    <property name="use-underline">True</property>
                  </object>
                </child>
                <child>
                  <object class="AdwSwitchRow" id="display_contact_pictures_row">
                    <property name="title" translatable="yes">Show contact _pictures</property>
                    <property name="subtitle" translatable="yes">Existing contact picture or initials for the summary sender; first To/Cc recipient in outgoing folders</property>
                    <property name="use-underline">True</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
