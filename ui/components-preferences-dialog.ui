<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="ComponentsPreferencesDialog" parent="AdwPreferencesDialog">
    <property name="content-height">700</property>
    <child>
      <object class="AdwPreferencesPage">
        <!-- Translators: Preferences page title -->
        <property name="title" translatable="yes">Preferences</property>
        <property name="icon-name">preferences-other-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwSwitchRow" id="remember_last_inbox_row">
                <property name="title" translatable="yes">_Reopen last inbox</property>
                <property name="subtitle" translatable="yes">Open whichever inbox was viewed last</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="AdwComboRow" id="startup_inbox_row">
                <property name="title" translatable="yes">Inbox at _startup</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="startup_notifications_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">_Watch for new mail when closed</property>
                <property name="tooltip-text" translatable="yes">Convey will keep running after all windows are closed</property>
                <property name="use-underline">True</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwSwitchRow" id="local_starred_folder_row">
                <property name="title" translatable="yes">_Always show Starred folder</property>
                <property name="subtitle" translatable="yes">Show a local Starred folder for accounts whose server does not provide one</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="display_preview_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">_Display conversation preview</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="flat_panes_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">_Blend conversation list with window</property>
                <property name="subtitle" translatable="yes">Use the window background for improved text contrast</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="autoselect_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">_Automatically select next message</property>
                <property name="use-underline">True</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwSwitchRow" id="trust_images_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">_Load images from verified senders</property>
                <property name="subtitle" translatable="yes">Showing remote images allows the sender to track you</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="unverified_images_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">Also load images from _unverified senders</property>
                <property name="subtitle" translatable="yes">Messages that can't be verified are often spam or phishing</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="unset_html_colors_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">_Override the original colors in HTML emails</property>
                <property name="subtitle" translatable="yes">Overrides the original colors in HTML messages to integrate better with the app theme.</property>
                <property name="use-underline">True</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwSwitchRow" id="single_key_shortcuts_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">Use _single key email shortcuts</property>
                <property name="tooltip-text" translatable="yes">Enable keyboard shortcuts for email actions that do not require pressing &lt;Ctrl&gt;</property>
                <property name="use-underline">True</property>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="AdwPreferencesGroup">
            <child>
              <object class="AdwSwitchRow" id="custom_proxy_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">Use _custom proxy</property>
                <property name="subtitle" translatable="yes">Set a proxy for Convey to use for all network requests</property>
                <property name="use-underline">True</property>
              </object>
            </child>
            <child>
              <object class="AdwEntryRow" id="proxy_uri_row">
                <!-- Translators: Preferences label -->
                <property name="title" translatable="yes">Proxy Address (e.g. socks5://127.0.0.1:9050)</property>
                <property name="show-apply-button">True</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>

    <child>
      <object class="AdwPreferencesPage">
        <!-- Translators: Preferences page title -->
        <property name="title" translatable="yes">Plugins</property>
        <property name="icon-name">application-x-addon-symbolic</property>

        <child>
          <object class="AdwPreferencesGroup" id="plugins_group">
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
