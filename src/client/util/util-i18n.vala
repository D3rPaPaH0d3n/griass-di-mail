/**
 * Internationalisation support functions.
 */
namespace Util.I18n {

    /** Determines if an account presents its user folders as labels. */
    public bool uses_labels(Convey.Account account) {
        return (
            account.information.service_provider == Convey.ServiceProvider.GMAIL
        );
    }

    private GLib.HashTable<string, string> language_names = null;
    private GLib.HashTable<string, string> country_names = null;

    public const string SYSTEM_LOCALE = "";

    void init(string package_name, string program_path, string locale = SYSTEM_LOCALE) {
        Intl.setlocale(LocaleCategory.ALL, locale);
        Intl.bindtextdomain(package_name, get_langpack_dir_path(program_path));
        Intl.bind_textdomain_codeset(package_name, "UTF-8");
        Intl.textdomain(package_name);
    }

    // TODO: Convey should be able to use langpacks from the build directory
    private string get_langpack_dir_path(string program_path) {
        return Config.LANGUAGE_SUPPORT_DIRECTORY;
    }

    /**
     * Returns a sorted list of installed spell-check dictionary languages.
     *
     * Each language is a POSIX-style locale name (ISO/IEC 15897).
     * The list is generated by obtaining the list from Enchant via
     * {@link Enchant.Broker.list_dicts}, discarding generic languages
     * if a regional variant exists (for example, discard "en" if
     * "en_US" is included), then sorted.
     */
    public string[] get_available_dictionaries() {
        string[] dictionaries = {};

        Enchant.Broker broker = new Enchant.Broker();
        broker.list_dicts((lang_tag, provider_name, provider_desc, provider_file) => {
                dictionaries += lang_tag;
            });

        // Whenever regional variants of the dictionaries are available use them
        // in place of the generic ones, e.g., discard en if en_US, en_GB, ...
        // are installed on the system.
        GLib.GenericSet<string> regional_dictionaries =
        new GLib.GenericSet<string>(GLib.str_hash, GLib.str_equal);
        foreach (string dic in dictionaries) {
            if ("_" in dic) {
                int underscore = dic.index_of_char('_');
                regional_dictionaries.add(dic.substring(0, underscore));
            }
        }

        GLib.List<string> filtered_dictionaries = new GLib.List<string>();
        foreach (string dic in dictionaries) {
            if ("_" in dic || ! regional_dictionaries.contains(dic))
                filtered_dictionaries.append(dic);
        }

        filtered_dictionaries.sort((dic_a, dic_b) => (dic_a < dic_b) ? -1 : 1);

        dictionaries = {};
        foreach (string dic in filtered_dictionaries) {
            dictionaries += dic;
        }

        return dictionaries;
    }

    private const string DICTIONARIES_URL =
        "https://raw.githubusercontent.com/wooorm/dictionaries/8cfea406b505e4d7df52d5a19bce525df98c54ab/dictionaries/";

    private const string[] DOWNLOADABLE_DICTIONARIES = {
        "bg_BG:bg", "br_FR:br", "ca_ES:ca", "cs_CZ:cs", "cy_GB:cy",
        "da_DK:da", "de_AT:de-AT", "de_CH:de-CH", "de_DE:de", "el_GR:el",
        "en_AU:en-AU", "en_CA:en-CA", "en_GB:en-GB", "en_US:en",
        "en_ZA:en-ZA", "eo:eo", "es_AR:es-AR", "es_BO:es-BO", "es_CL:es-CL",
        "es_CO:es-CO", "es_CR:es-CR", "es_CU:es-CU", "es_DO:es-DO",
        "es_EC:es-EC", "es_ES:es", "es_GT:es-GT", "es_HN:es-HN",
        "es_MX:es-MX", "es_NI:es-NI", "es_PA:es-PA", "es_PE:es-PE",
        "es_PH:es-PH", "es_PR:es-PR", "es_PY:es-PY", "es_SV:es-SV",
        "es_US:es-US", "es_UY:es-UY", "es_VE:es-VE", "et_EE:et", "eu_ES:eu",
        "fa_IR:fa", "fo_FO:fo", "fr_FR:fr", "fur_IT:fur", "fy_NL:fy",
        "ga_IE:ga", "gd_GB:gd", "gl_ES:gl", "he_IL:he", "hr_HR:hr",
        "hu_HU:hu", "hy_AM:hy", "ia:ia", "ie:ie", "is_IS:is", "it_IT:it",
        "ka_GE:ka", "ko_KR:ko", "la:la", "lb_LU:lb", "lt_LT:lt",
        "ltg_LV:ltg", "lv_LV:lv", "mk_MK:mk", "mn_MN:mn", "nb_NO:nb",
        "nds_DE:nds", "ne_NP:ne", "nl_NL:nl", "nn_NO:nn", "oc_FR:oc",
        "pl_PL:pl", "pt_BR:pt", "pt_PT:pt-PT", "ro_RO:ro", "ru_RU:ru",
        "rw_RW:rw", "sk_SK:sk", "sl_SI:sl", "sr_RS:sr", "sv_FI:sv-FI",
        "sv_SE:sv", "tk_TM:tk", "tr_TR:tr", "uk_UA:uk", "vi_VN:vi"
    };

    /**
     * Returns the languages that {@link download_dictionary} can install.
     */
    public string[] get_downloadable_dictionaries() {
        string[] langs = {};
        foreach (string entry in DOWNLOADABLE_DICTIONARIES) {
            langs += entry.split(":")[0];
        }
        return langs;
    }

    public delegate void DownloadProgress(double fraction);

    /**
     * Downloads a dictionary into the user's Enchant hunspell directory.
     */
    public async void download_dictionary(string lang,
                                          DownloadProgress? progress,
                                          GLib.Cancellable? cancellable)
        throws GLib.Error {
        string? source = null;
        foreach (string entry in DOWNLOADABLE_DICTIONARIES) {
            string[] parts = entry.split(":");
            if (parts[0] == lang) {
                source = parts[1];
            }
        }
        if (source == null) {
            throw new GLib.IOError.NOT_FOUND("No dictionary for %s", lang);
        }

        string path = GLib.Path.build_filename(
            GLib.Environment.get_user_config_dir(), "enchant", "hunspell"
        );
        GLib.DirUtils.create_with_parents(path, 0755);
        GLib.File dir = GLib.File.new_for_path(path);

        var session = new Soup.Session();
        session.remove_feature_by_type(typeof(Soup.ContentDecoder));
        if (Convey.Endpoint.proxy_resolver != null) {
            session.proxy_resolver = Convey.Endpoint.proxy_resolver;
        }
        foreach (string ext in new string[] { "aff", "dic" }) {
            var msg = new Soup.Message(
                "GET", DICTIONARIES_URL + source + "/index." + ext
            );
            GLib.InputStream input = yield session.send_async(
                msg, GLib.Priority.DEFAULT, cancellable
            );
            if (msg.status_code != Soup.Status.OK) {
                throw new GLib.IOError.FAILED(
                    "HTTP %u downloading %s", msg.status_code, lang
                );
            }
            int64 total = msg.response_headers.get_content_length();
            int64 received = 0;
            GLib.File part = dir.get_child(lang + "." + ext + ".part");
            GLib.OutputStream output = yield part.replace_async(
                null, false, REPLACE_DESTINATION, GLib.Priority.DEFAULT, cancellable
            );
            while (true) {
                GLib.Bytes chunk = yield input.read_bytes_async(
                    65536, GLib.Priority.DEFAULT, cancellable
                );
                if (chunk.get_size() == 0) {
                    break;
                }
                yield output.write_all_async(
                    chunk.get_data(), GLib.Priority.DEFAULT, cancellable, null
                );
                received += chunk.get_size();
                if (ext == "dic" && progress != null && total > 0) {
                    progress(double.min((double) received / total, 1.0));
                }
            }
            yield output.close_async(GLib.Priority.DEFAULT, cancellable);
            part.move(dir.get_child(lang + "." + ext), OVERWRITE, cancellable);
        }
    }

    /**
     * Returns a list of installed locale languages.
     *
     * Each language is a POSIX-style locale name (ISO/IEC 15897).
     * The list is generated by executing `locale -a`.
     */
    public string[] get_available_locales() {
        string[] locales = {};

        try {
            string? output = null;
            GLib.Subprocess p = new GLib.Subprocess.newv({ "locale", "-a" },
                                                         GLib.SubprocessFlags.STDOUT_PIPE);
            p.communicate_utf8(null, null, out output, null);

            foreach (string l in output.split("\n")) {
                locales += l;
            }
        } catch (GLib.Error e) {
            return locales;
        }

        return locales;
    }

    /*
     * Strip the information about the encoding from the locale.
     *
     * That is, en_US.UTF-8 is mapped to en_US, while en_GB remains
     * unchanged.
     */
    public string strip_encoding(string locale) {
        int dot = locale.index_of_char('.');
        return locale.substring(0, dot);
    }

    /**
     * Returns a list of preferred spell-check languages.
     *
     * Each language is a POSIX-style locale name (ISO/IEC 15897).
     * The list is generated by obtaining the list of POSIX locales
     * specified by the `LANGUAGE` environment variable, and including
     * each that has both an available dictionary and locale.
     *
     * @see get_available_dictionaries
     * @see get_available_locales
     */
    public string[] get_user_preferred_languages() {
        GLib.GenericSet<string> dicts = new GLib.GenericSet<string>(GLib.str_hash, GLib.str_equal);
        foreach (string dict in get_available_dictionaries()) {
            dicts.add(dict);
        }

        GLib.GenericSet<string> locales = new GLib.GenericSet<string>(GLib.str_hash, GLib.str_equal);
        foreach (string locale in get_available_locales()) {
            locales.add(strip_encoding(locale));
        }

        string[] output = {};
        unowned string[] language_names = GLib.Intl.get_language_names();
        foreach (string lang in language_names) {
            // Check if we have the associated locale and the dictionary installed before actually
            //  considering this language.
            if (lang != "C" && dicts.contains(lang) && locales.contains(lang)) {
                output += lang;
            }
        }
        return output;
    }

    public string? language_name_from_locale (string locale) {
        if (language_names == null) {
            language_names = new HashTable<string, string>(GLib.str_hash, GLib.str_equal);

            unowned Xml.Doc doc = Xml.Parser.parse_file(Config.ISO_CODE_639_XML);
            if (doc == null) {
                return null;
            }
            else {
                unowned Xml.Node root = doc.get_root_element();
                for (unowned Xml.Node entry = root.children; entry != null; entry = entry.next) {
                    if (entry.type == Xml.ElementType.ELEMENT_NODE) {
                        string? iso_639_1 = null;
                        string? language_name = null;

                        for (unowned Xml.Attr a = entry.properties; a != null; a = a.next) {
                            switch (a.name) {
                            case "iso_639_1_code":
                                iso_639_1 = a.children->content;
                                break;
                            case "name":
                                language_name = a.children->content;
                                break;
                            default:
                                break;
                            }

                            if (language_name != null) {
                                if (iso_639_1 != null) {
                                    language_names.insert(iso_639_1, language_name);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Look for the name of language matching only the part before the _
        int pos = -1;
        if ("_" in locale) {
            pos = locale.index_of_char('_');
        }

        // Return a translated version of the language.
        string language_name = GLib.dgettext("iso_639", language_names.get(locale.substring(0, pos)));

        return language_name;
    }

    public string? country_name_from_locale(string locale) {
        if (country_names == null) {
            country_names = new HashTable<string, string>(GLib.str_hash, GLib.str_equal);

            unowned Xml.Doc doc = Xml.Parser.parse_file(Config.ISO_CODE_3166_XML);

            if (doc == null) {
                return null;
            }
            else {
                unowned Xml.Node root = doc.get_root_element();
                for (unowned Xml.Node entry = root.children; entry != null; entry = entry.next) {
                    if (entry.type == Xml.ElementType.ELEMENT_NODE) {
                        string? iso_3166 = null;
                        string? country_name = null;

                        for (unowned Xml.Attr a = entry.properties; a != null; a = a.next) {
                            switch (a.name) {
                            case "alpha_2_code":
                                iso_3166 = a.children->content;
                                break;
                            case "name":
                                country_name = a.children->content;
                                break;
                            default:
                                break;
                            }

                            if (country_name != null) {
                                if (iso_3166 != null) {
                                    country_names.insert(iso_3166, country_name);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Look for the name of language matching only the part before the _
        int pos = -1;
        if ("_" in locale) {
            pos = locale.index_of_char('_');
        }

        string country_name  = GLib.dgettext("iso_3166", country_names.get(locale.substring(pos+1)));

        return country_name;
    }

    /**
     * Returns the localised display name name for specific folder.
     *
     * If the folder has a special type, the result of {@link
     * to_folder_type_display_name} is returned, otherwise the last
     * folder path step is returned.
     */
    public string? to_folder_display_name(Convey.Folder folder) {
        var name = to_folder_type_display_name(folder.used_as);
        if (Convey.String.is_empty_or_whitespace(name)) {
            name = folder.path.name;
        }
        return name;
    }

    /**
     * Returns the localised name for a specific folder type, if any.
     */
    public unowned string? to_folder_type_display_name(Convey.Folder.SpecialUse use) {
        switch (use) {
            case INBOX:
                return _("Inbox");

            case DRAFTS:
                return _("Drafts");

            case SENT:
                return _("Sent");

            case FLAGGED:
                return _("Starred");

            case IMPORTANT:
                return _("Important");

            case ALL_MAIL:
                return _("All Mail");

            case JUNK:
                return _("Junk");

            case TRASH:
                return _("Trash");

            case OUTBOX:
                return _("Outbox");

            case SEARCH:
                return _("Search");

            case ARCHIVE:
                return _("Archive");

            case NONE:
            default:
                return null;
        }
    }

}
